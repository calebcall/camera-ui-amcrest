{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true,
    "noImplicitAny": true,
    // TypeScript 6 no longer pulls in every @types/* package automatically,
    // so the ambient Node globals (Buffer, NodeJS.*, node: builtins) have to
    // be requested by name.
    "types": ["node"]
  },
  "include": ["src"],
  // Tests are type-checked by tsconfig.test.json, which does not emit. Keeping
  // them out of this project stops `npm run build` writing a .js/.d.ts/.js.map
  // triplet per test file into dist/. See #41.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
